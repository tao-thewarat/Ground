<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_base_document_layout" model="ir.ui.view">
        <field name="name">Document Layout</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout" />
        <field name="arch" type="xml">
            <field name="secondary_color" position="after">
                <field
                    name="tertiary_color"
                    widget="color"
                    class="w-auto m-0"
                    invisible="not is_ibase_layout"
                />
            </field>

            <field name="report_header" position="attributes">
                <attribute name="invisible">is_ibase_layout</attribute>
            </field>

            <field name="font" position="attributes">
                <attribute name="string">Font</attribute>
            </field>

            <field name="report_footer" position="attributes">
                <attribute name="invisible">is_ibase_layout</attribute>
            </field>

            <field name="company_details" position="before">
                <field
                    name="shading_option"
                    widget="badges_selection"
                    options="{'horizontal': true, 'size': 'sm'}"
                    invisible="not is_ibase_layout or report_tables_id != 'ibase'"
                    required="is_ibase_layout and report_tables_id == 'ibase'"
                />
            </field>

            <field name="paperformat_id" position="after">
                <field
                    name="company_stamp"
                    widget="image"
                    options="{'size': [0, 50]}"
                    invisible="not is_ibase_layout"
                />
                <field
                    name="shading_stamp"
                    widget="badges_selection"
                    options="{'horizontal': true, 'size': 'sm'}"
                    invisible="not company_stamp"
                    required="company_stamp"
                />
            </field>
        </field>
    </record>
</odoo>
